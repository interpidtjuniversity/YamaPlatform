<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.clcy.grade_feedback.dao.GroupClassInfoDao">

    <resultMap type="com.clcy.grade_feedback.entity.GroupClassInfo" id="GroupClassInfoMap">
        <result property="id" column="id" jdbcType="INTEGER"/>
        <result property="groupName" column="group_name" jdbcType="VARCHAR"/>
        <result property="classId" column="class_id" jdbcType="INTEGER"/>
        <result property="className" column="class_name" jdbcType="VARCHAR"/>
        <result property="groupingStrategy" column="grouping_strategy" jdbcType="VARCHAR"/>
        <result property="groupingInfo" column="grouping_info" jdbcType="VARCHAR"/>
        <result property="type" column="type" jdbcType="VARCHAR"/>
    </resultMap>

    <!--创建新分组-->
    <insert id="createGroupsForClass">
        INSERT INTO
            grade_feedback.group_class_info(group_name, class_id, class_name, grouping_strategy, grouping_info, type)
        VALUES
        <foreach collection="groups" item="group" separator=",">
            (#{group.groupName}, #{group.classId}, #{group.className}, #{group.groupingStrategy}, #{group.groupingInfo}, #{group.type})
        </foreach>
    </insert>


    <select id="queryGroupsInClass" resultMap="GroupClassInfoMap">
        select
            *
        from grade_feedback.group_class_info
        where class_id = #{classId}
            limit 100
    </select>

    <select id="queryGroupClass" resultMap="GroupClassInfoMap">
        select
            *
        from grade_feedback.group_class_info
        where id = #{groupId}
            limit 1
    </select>

</mapper>